# Un único dominio HTTPS sirve React, FastAPI, WebSockets y el APK Flutter.
# ACMA_DOMINIO se define solamente en el .env local del VPS.
{$ACMA_DOMINIO} {
    encode zstd gzip
    reverse_proxy api:8000 {
        flush_interval -1
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        -Server
    }
}
