# Copia este archivo como .env (raíz) — lo leen docker compose y el backend.
# Los valores de abajo son solo para desarrollo local.

# --- Entorno -----------------------------------------------------------------
ACMA_ENTORNO=desarrollo            # desarrollo | pruebas | produccion

# --- PostgreSQL (docker) -------------------------------------------------------
POSTGRES_SUPERUSER=acma_super
POSTGRES_SUPERPASSWORD=cambiar_super
ACMA_OWNER_PASSWORD=cambiar_owner
ACMA_API_PASSWORD=cambiar_api
POSTGRES_HOST_PORT=5442

# Conexión de la aplicación (rol acma_api, sin BYPASSRLS).
DATABASE_URL=postgresql+asyncpg://acma_api:cambiar_api@localhost:5442/acma
# Réplica de lectura (opcional). Vacía = se usa DATABASE_URL.
DATABASE_READ_URL=
# Conexión de migraciones (rol dueño del esquema). Solo la usa Alembic.
DATABASE_MIGRATIONS_URL=postgresql+asyncpg://acma_owner:cambiar_owner@localhost:5442/acma

# Base de pruebas (pytest).
TEST_DATABASE_URL=postgresql+asyncpg://acma_api:cambiar_api@localhost:5442/acma_test
TEST_DATABASE_MIGRATIONS_URL=postgresql+asyncpg://acma_owner:cambiar_owner@localhost:5442/acma_test

# --- Redis / Celery --------------------------------------------------------------
REDIS_HOST_PORT=6389
REDIS_URL=redis://localhost:6389/0
CELERY_BROKER_URL=redis://localhost:6389/1
CELERY_RESULT_BACKEND=redis://localhost:6389/2

# --- MinIO -----------------------------------------------------------------------
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
MINIO_ROOT_USER=acma_minio
MINIO_ROOT_PASSWORD=cambiar_minio
ALMACENAMIENTO_MODO=minio          # minio | memoria
MINIO_ENDPOINT=localhost:9010
MINIO_BUCKET=acma
MINIO_SEGURO=false

# --- Seguridad -------------------------------------------------------------------
# Genera valores nuevos con:  py -3.12 backend/scripts/generar_secretos.py
JWT_SECRETO=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
# Clave AES-256 en base64 (32 bytes) para cifrado de columnas sensibles.
CLAVE_CIFRADO=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_ACCESO_MINUTOS=15
REFRESH_DIAS=7
# false solo en desarrollo: los roles críticos no exigen MFA para la demo.
MFA_OBLIGATORIO=false
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# P05: push PWA (web-push). Genera las claves con: backend\.venv\Scripts\python -m scripts.generar_vapid
VAPID_CLAVE_PUBLICA=
VAPID_CLAVE_PRIVADA=
VAPID_CONTACTO=mailto:soporte@acma.dev
# Tiempo real del chat: redis (varios procesos) o local
TIEMPO_REAL_MODO=redis

# P07: correo saliente por SMTP (vacío = modo stub: los .eml se guardan en MinIO bajo correo/ y se registran en el log).
# Sirve para el correo corporativo o para SendGrid por SMTP (host smtp.sendgrid.net, usuario "apikey", contraseña = API key).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ACMA <no-responder@acma.dev>
SMTP_TLS=starttls               # starttls | ssl | none
# URL pública de la app (enlaces de correo y push)
APP_URL_PUBLICA=http://localhost:5173
# true = enviar notificaciones en la misma petición (sin Celery); false = encolar en Celery
NOTIFICACIONES_ENVIO_INLINE=false
