# ACMA · plantilla del .env de PRODUCCION. Copiala al servidor como .env y rellena cada <...>.
# Los valores reales NUNCA se guardan en el repositorio: generalos con
#   backend/.venv/Scripts/python -m scripts.generar_secretos --compose
# y conservalos en el gestor de secretos del cliente.
#
# El backend se niega a arrancar si algun secreto conserva un valor de ejemplo, si falta el dominio en
# CORS_ORIGENES, si APP_URL_PUBLICA no es https o si MFA_OBLIGATORIO no es true (core/config.py).

# --- Entorno -----------------------------------------------------------------
ACMA_ENTORNO=produccion

# --- PostgreSQL 16 + PostGIS -------------------------------------------------
POSTGRES_SUPERUSER=acma_super
POSTGRES_SUPERPASSWORD=<generado>
ACMA_OWNER_PASSWORD=<generado>
ACMA_API_PASSWORD=<generado>
# La API usa el rol acma_api (sin BYPASSRLS); Alembic usa acma_owner. No intercambiarlos.
DATABASE_URL=postgresql+asyncpg://acma_api:<ACMA_API_PASSWORD>@postgres:5432/acma
DATABASE_MIGRATIONS_URL=postgresql+asyncpg://acma_owner:<ACMA_OWNER_PASSWORD>@postgres:5432/acma
# Replica de lectura (opcional): los tableros y reportes la aprovechan si se configura.
DATABASE_READ_URL=
# En produccion no hay base de pruebas.
TEST_DATABASE_URL=
TEST_DATABASE_MIGRATIONS_URL=

# --- Redis / Celery (con contrasena) -----------------------------------------
REDIS_PASSWORD=<generado>
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
CELERY_BROKER_URL=redis://:<REDIS_PASSWORD>@redis:6379/1
CELERY_RESULT_BACKEND=redis://:<REDIS_PASSWORD>@redis:6379/2
TIEMPO_REAL_MODO=redis

# --- MinIO (evidencias, PDF y respaldos) -------------------------------------
ALMACENAMIENTO_MODO=minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=<usuario>
MINIO_ROOT_PASSWORD=<generado>
MINIO_BUCKET=acma
# true cuando MinIO se publica detras de TLS; dentro de la red de docker queda en false.
MINIO_SEGURO=false

# --- Seguridad ---------------------------------------------------------------
JWT_SECRETO=<generado: 48 bytes url-safe>
CLAVE_CIFRADO=<generado: 32 bytes en base64>
JWT_ACCESO_MINUTOS=15
REFRESH_DIAS=7
# §6.9.5: obligatorio en produccion; el guardia de configuracion lo exige.
MFA_OBLIGATORIO=true
# Vida de la sesion: 8 h normal, 2 h en roles administrativos, cierre por 30 min de inactividad.
SESION_HORAS=8
SESION_HORAS_ADMIN=2
SESION_INACTIVIDAD_MINUTOS=30
# Vencimiento de contraseña de los roles administrativos (0 = sin vencimiento).
CONTRASENA_DIAS_ADMIN=90
# Retencion de la bitacora de API: 90 dias las llamadas normales, 1 año los errores 4xx/5xx.
RETENCION_ACCESOS_DIAS=90
RETENCION_ACCESOS_ERRORES_DIAS=365
# Base GeoLite2 opcional para la geolocalizacion aproximada del login (vacio = se audita geo: null).
GEOIP_BASE=
# Solo el dominio real del frontend; el comodin esta prohibido en produccion.
CORS_ORIGENES=https://<dominio-del-cliente>

# --- Push PWA (VAPID) --------------------------------------------------------
# backend/.venv/Scripts/python -m scripts.generar_vapid
VAPID_CLAVE_PUBLICA=<generado>
VAPID_CLAVE_PRIVADA=<generado>
VAPID_CONTACTO=mailto:<soporte@dominio>

# --- Correo saliente (SMTP corporativo) --------------------------------------
SMTP_HOST=<smtp.dominio>
SMTP_PORT=587
SMTP_USER=<usuario>
SMTP_PASSWORD=<secreto>
SMTP_FROM=ACMA <no-responder@<dominio>>
SMTP_TLS=starttls
# Debe ser https: las cookies de sesion son Secure.
APP_URL_PUBLICA=https://<dominio-del-cliente>
# false en produccion: las notificaciones se encolan en Celery.
NOTIFICACIONES_ENVIO_INLINE=false

# --- Caddy (TLS automatico) ---------------------------------------------------
ACMA_DOMINIO=<dominio-del-cliente>
ACMA_CORREO_TLS=<correo-para-lets-encrypt>
