# ACMA con infraestructura en la nube — NO renombrar ni usar sin
# completar una MIGRACION VALIDADA. No se modifica el .env original.
# Se requiere un proyecto Supabase exclusivo para ACMA.
# IMPORTANTE: verificar primero roles, PostGIS, migraciones RLS y respaldos.

ACMA_ENTORNO=desarrollo
# Conexión PostgreSQL por driver asyncpg desde FastAPI (no desde el navegador).
# Configurar el usuario de aplicación SIN privilegios para omitir RLS.
DATABASE_URL=postgresql+asyncpg://ACMA_API_USER:CAMBIAR@HOST_SUPABASE:5432/postgres?ssl=require
DATABASE_MIGRATIONS_URL=postgresql+asyncpg://ACMA_OWNER:CAMBIAR@HOST_SUPABASE:5432/postgres?ssl=require
DATABASE_READ_URL=

# Archivos cifrados; bucket privado creado manualmente en proyecto ACMA.
ALMACENAMIENTO_MODO=supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=REEMPLAZAR_SOLO_EN_SERVIDOR
SUPABASE_BUCKET=acma

# NO conectar con otros proyectos por accidente.
# Redis/Celery requieren un plan separado de migración a Cron/Queues/workers.
REDIS_URL=redis://localhost:6389/0
CELERY_BROKER_URL=redis://localhost:6389/1
CELERY_RESULT_BACKEND=redis://localhost:6389/2
TIEMPO_REAL_MODO=local
NOTIFICACIONES_ENVIO_INLINE=true

JWT_SECRETO=GENERAR_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES
CLAVE_CIFRADO=GENERAR_LLAVE_BASE64_DE_32_BYTES_Y_CONSERVARLA
MFA_OBLIGATORIO=false
CORS_ORIGENES=http://localhost:8000
APP_URL_PUBLICA=http://localhost:8000
