# Plantilla para ACMA con Supabase y Redis alojados; NO es configuración funcional
# hasta validar la migración. NO subir el archivo .env real a GitHub.
# Usar un proyecto Supabase nuevo SOLO para ACMA.

ACMA_ENTORNO=desarrollo
# Obligatorio: 201 tablas y particiones están en el esquema PRIVADO acma.
DB_SCHEMA=acma
# Copia la URL de la conexión PostgreSQL desde Supabase → Connect.
# Para un servidor IPv4, usar SESSION pooler (puerto 5432).
# Las dos cuentas serán creadas SOLO tras la revisión de roles/RLS.
DATABASE_URL=postgresql+asyncpg://USUARIO_ACMA_API:CAMBIAR@HOST_REAL:5432/postgres?ssl=require
DATABASE_MIGRATIONS_URL=postgresql+asyncpg://USUARIO_ACMA_OWNER:CAMBIAR@HOST_REAL:5432/postgres?ssl=require
DATABASE_READ_URL=

# Bucket Supabase PRIVADO (ya creado y revisado); sin secretos en Flutter/React.
ALMACENAMIENTO_MODO=supabase
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SECRET_KEY=SOLO_EN_BACKEND_NUNCA_SUBIR_GIT
SUPABASE_BUCKET=acma

# Redis externo administrado: se retienen Celery Worker/Beat para TODAS las
# funciones originales. No se reutiliza Redis local de Docker.
# Usar rediss:// y TLS con proveedor de Redis compatible con Celery.
REDIS_URL=rediss://USUARIO:CAMBIAR@HOST_REDIS:PUERTO/0?ssl_cert_reqs=required
CELERY_BROKER_URL=rediss://USUARIO:CAMBIAR@HOST_REDIS:PUERTO/1?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://USUARIO:CAMBIAR@HOST_REDIS:PUERTO/2?ssl_cert_reqs=required
TIEMPO_REAL_MODO=redis
NOTIFICACIONES_ENVIO_INLINE=false

# Para conservar la optimización de rutas usar OR-Tools ejecutado en proceso.
# En algunos Windows se bloquea el binario nativo; alojar FastAPI en Linux
# si no se puede instalar. NO sustituirlo por rutas simuladas.
RUTAS_MOTOR_TRANSPORTE=en_proceso

# Generar secretos y custodiar la misma CLAVE_CIFRADO en todas las instancias
# para descifrar los archivos históricos.
JWT_SECRETO=GENERAR_CADENA_ALEATORIA_LARGA
CLAVE_CIFRADO=GENERAR_BASE64_32_BYTES_Y_CUSTODIAR
MFA_OBLIGATORIO=false
CORS_ORIGENES=http://localhost:8000
APP_URL_PUBLICA=http://localhost:8000

# Para producción activar ACMA_ENTORNO=produccion, MFA_OBLIGATORIO=true,
# HTTPS en APP_URL_PUBLICA y CORS_ORIGENES, y reemplazar todos los ejemplos.
# Completar las variables SMTP/VAPID/Mensajería del .env.example si se usan.

# --- Mailjet HTTPS (opcional; compatible con Railway sin SMTP) ------------
# Por defecto "auto" conserva Resend > SMTP > stub. No se activa solo.
# Para habilitar Mailjet en Railway: CORREO_PROVEEDOR=mailjet y las tres
# variables MAILJET_... siguientes. El remitente debe estar verificado
# como "Active" en Mailjet (puede ser una direccion individual).
# Nunca guardes credenciales reales en GitHub.
CORREO_PROVEEDOR=auto
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM=

